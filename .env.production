# Build-time defaults for Vercel and any other CI build.
#
# Both values are public by design. The publishable key only grants what the
# row level security policies allow, and it is already visible in the browser
# bundle that Vite produces, so committing it exposes nothing new.
#
# Real environment variables take precedence over this file, so anything set
# in the Vercel project settings overrides these defaults without a commit.
#
# If the key is ever rotated, update it here as well.
VITE_SUPABASE_URL=https://bzsrnypedhkbbxttdcln.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vB2GchzdJq9MA2K4QKPEWQ_4pe_ysR3
